# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Fetched caches and raw dumps (regenerable)
data/cache/
data/raw/

# Model checkpoints (pinned by revision, never committed)
models/
hf_cache/

# Forecast cache (regenerable from seeds + pinned revisions)
artifacts/forecasts/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Secrets
.env

# GIFT-Eval benchmark data: re-downloadable, and grows to many GB across tasks
data/gift_eval/

# per-env HF datasets caches (datasets 2.x cannot read 5.x cache entries)
envs/*/.hf_datasets_cache/
